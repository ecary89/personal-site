{
  "$description": "erikacary.com portfolio tokens. Generated from tokens.css by build-tokens.js. Do not edit by hand.",
  "color": {
    "paper": {
      "$type": "color",
      "$value": "#F9F4F6",
      "$description": "page background, warm rose-tinted"
    },
    "surface": {
      "$type": "color",
      "$value": "#FFFFFF",
      "$description": "inputs, frames and cards that sit on paper"
    },
    "ink": {
      "$type": "color",
      "$value": "#2B2130",
      "$description": "default text, primary button"
    },
    "muted": {
      "$type": "color",
      "$value": "#6E6072",
      "$description": "every secondary text: reading text, meta, nav, captions, cites. 5.4:1"
    },
    "rose": {
      "$type": "color",
      "$value": "#B4547E",
      "$description": "the one accent, for fills and large text: buttons, arrows, cursor, curtain"
    },
    "rose-text": {
      "$type": "color",
      "$value": "#A44C73",
      "$description": "rose for text under 18px: labels, links, errors. 5.0:1 on paper, 4.5:1 on the wash"
    },
    "hairline": {
      "$type": "color",
      "$value": "#E2D6DC",
      "$description": "frame borders"
    },
    "border": {
      "$type": "color",
      "$value": "#D5C4CD",
      "$description": "ghost button, input, dotted dividers, chart grid"
    },
    "wash": {
      "$type": "color",
      "$value": "#F2E8ED",
      "$description": "hover wash, empty media"
    },
    "wash-deep": {
      "$type": "color",
      "$value": "#E7D6DF",
      "$description": "far end of the media gradient"
    },
    "paper-glass": {
      "$type": "color",
      "$value": "#F9F4F6F0",
      "$description": "sticky header bar, over an 8px blur"
    },
    "rose-tint": {
      "$type": "color",
      "$value": "#F6EAF0",
      "$description": "highlighted chart area"
    },
    "neutral-tint": {
      "$type": "color",
      "$value": "#ECEBEC",
      "$description": "de-emphasized chart area"
    },
    "neutral": {
      "$type": "color",
      "$value": "#7A7479",
      "$description": "de-emphasized chart label"
    },
    "control-off-bg": {
      "$type": "color",
      "$value": "#EFE9EC",
      "$description": "disabled arrow"
    },
    "control-off-fg": {
      "$type": "color",
      "$value": "#A69DA3"
    },
    "control-pending": {
      "$type": "color",
      "$value": "#8D7E91",
      "$description": "the arrow about to turn the page while a carousel cycles. White icon: 3.8:1"
    },
    "stage-graphite": {
      "$type": "color",
      "$value": "#2C2C2C",
      "$description": "behind dark UI screenshots that crossfade"
    },
    "surface-veil": {
      "$type": "color",
      "$value": "#FFFFFF8C",
      "$description": "a placeholder sitting on the wash"
    },
    "btn-border": {
      "$type": "color",
      "$value": "{color.border}"
    },
    "btn-wash": {
      "$type": "color",
      "$value": "{color.wash}"
    },
    "subtle": {
      "$type": "color",
      "$value": "{color.muted}",
      "$description": "was #8D7E91, too faint for text (3.5:1)"
    }
  },
  "gradient": {
    "wash": {
      "$type": "gradient",
      "$value": [
        {
          "color": "{color.wash}",
          "position": 0
        },
        {
          "color": "{color.wash-deep}",
          "position": 1
        }
      ],
      "$extensions": {
        "angle": "135deg"
      }
    }
  },
  "font": {
    "family": {
      "display": {
        "$type": "fontFamily",
        "$value": [
          "Bricolage Grotesque",
          "sans-serif"
        ],
        "$description": "names, titles, headings, quotes"
      },
      "text": {
        "$type": "fontFamily",
        "$value": [
          "Schibsted Grotesk",
          "system-ui",
          "sans-serif"
        ],
        "$description": "reading text, UI and labels"
      }
    },
    "weight": {
      "regular": {
        "$type": "fontWeight",
        "$value": 400
      },
      "medium": {
        "$type": "fontWeight",
        "$value": 500
      },
      "semibold": {
