#!/bin/sh
# Git pre-commit hook:
#   1. stamp stylesheet/script references with a content hash (cache-busting for Cloudflare)
#   2. re-encrypt the /work pages if their plaintext changed, and stage the output
# Install once per clone:  cp scripts/pre-commit .git/hooks/pre-commit && chmod +x .git/hooks/pre-commit
set -e
cd "$(git rev-parse --show-toplevel)"
node scripts/version-assets.js --stage --quiet
if [ -f work/_src/passwords.json ]; then
    node scripts/lock.js --stage --quiet
fi
